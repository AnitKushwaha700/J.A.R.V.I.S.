{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "JARVIS",
  "version": "2.0.0",
  "identifier": "com.jarvis.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "title": "JARVIS — Personal AI Assistant",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3001 http://localhost:11434 https://api.coingecko.com https://en.wikipedia.org https://api.github.com https://export.arxiv.org https://api.duckduckgo.com https://hn.algolia.com"
    }
  },
  "plugins": {
    "global-shortcut": {
      "shortcuts": [
        {
          "name": "toggle-window",
          "shortcut": "CommandOrControl+Shift+J"
        }
      ]
    },
    "notification": {},
    "clipboard-manager": {}
  }
}
