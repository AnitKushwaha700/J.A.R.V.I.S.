{
  "name": "jarvis-v2",
  "version": "2.0.0",
  "private": true,
  "packageManager": "npm@11.2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "backend:dev": "npm run dev --workspace=apps/backend",
    "mobile:dev": "npm run dev --workspace=apps/mobile",
    "web:dev": "npm run dev --workspace=apps/web"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
