# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://jarvis:password@localhost:5432/jarvis_db

# ── Redis ─────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Authentication ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_random_32_char_minimum_string
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_this_to_another_random_string
REFRESH_TOKEN_EXPIRES_IN=7d

# ── AI Providers (all free tier) ──────────────────────────────────────────
# Google Gemini: https://aistudio.google.com/apikey (Free: 15 req/min)
GEMINI_API_KEY=

# Groq Cloud: https://console.groq.com/keys (Free: ~14400 req/day)
GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/keys (Free models available)
OPENROUTER_API_KEY=

# Ollama local: http://localhost:11434 (Unlimited, requires local GPU/CPU)
OLLAMA_BASE_URL=http://localhost:11434

# ── Voice ─────────────────────────────────────────────────────────────────
EDGE_TTS_VOICE=en-US-ChristopherNeural

# ── File Storage ──────────────────────────────────────────────────────────
STORAGE_TYPE=local
STORAGE_PATH=./uploads

# ── External APIs (optional enhancements) ─────────────────────────────────
# NewsAPI: https://newsapi.org (Free: 100 req/day)
NEWS_API_KEY=
# GitHub: https://github.com/settings/tokens (Increases rate limit to 5000/hr)
GITHUB_TOKEN=

# ── Application ───────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000,http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:3001
